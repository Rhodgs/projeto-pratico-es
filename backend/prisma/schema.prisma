generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  perfil    String   
  criadoEm  DateTime @default(now())

  turmasCriadas Turma[]       @relation("ProfessorTurmas")
  evidencias    Evidencia[]
  preferencias  Preferencias? 
  turmas        Turma[]       @relation("TurmaAlunos") 
}

model Turma {
  id          String   @id @default(uuid())
  nome        String
  codigo      String   @unique
  professorId String
  criadaEm    DateTime @default(now())

  professor Usuario   @relation("ProfessorTurmas", fields: [professorId], references: [id])
  alunos    Usuario[] @relation("TurmaAlunos") 
}

model Desafio {
  id          String   @id @default(uuid())
  titulo      String
  descricao   String
  pontuacao   Int
  prazoLimite DateTime
  criadoEm    DateTime @default(now())

  evidencias Evidencia[]
}

model Evidencia {
  id            String   @id @default(uuid())
  desafioId     String
  alunoId       String
  status        String   @default("pendente") 
  justificativa String?
  enviadoEm     DateTime @default(now())

  desafio Desafio @relation(fields: [desafioId], references: [id])
  aluno   Usuario @relation(fields: [alunoId], references: [id])
}

model Preferencias {
  usuarioId      String  @id
  modoEscuro     Boolean @default(false)
  modoDaltonismo Boolean @default(false)
  tamanhoFonte   Int     @default(16)

  usuario Usuario @relation(fields: [usuarioId], references: [id])
}